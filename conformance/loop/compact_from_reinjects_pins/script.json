{
  "spec_version": "0.2",
  "description": "A pin declared in the part a from-compaction summarizes is re-injected in the summary line; a pin the kept part still holds is not repeated.",
  "agent": {
    "nickname": "Tater",
    "instructions": "Be brief.",
    "tools": [
      {
        "name": "load_a",
        "description": "Load load_a.",
        "input_schema": {
          "type": "object"
        },
        "concurrency": "serial",
        "behavior": {
          "type": "fixed",
          "text": "Loaded.",
          "pin": {
            "key": "a",
            "content": "Alpha rules."
          }
        }
      },
      {
        "name": "load_b",
        "description": "Load load_b.",
        "input_schema": {
          "type": "object"
        },
        "concurrency": "serial",
        "behavior": {
          "type": "fixed",
          "text": "Loaded.",
          "pin": {
            "key": "b",
            "content": "Beta rules."
          }
        }
      }
    ],
    "compactor": {
      "instructions": "Summarize the conversation.",
      "keep": "none"
    }
  },
  "providers": [
    {
      "name": "claude",
      "api": "anthropic.messages",
      "model": "claude-opus-5-5",
      "responses": [
        "responses/01.sse",
        "responses/02.sse",
        "responses/03.sse",
        "responses/04.sse",
        "responses/05.sse",
        "responses/06.sse"
      ]
    }
  ],
  "clock": {
    "start": "2026-09-26T00:00:00.000Z",
    "step_ms": 1
  },
  "ids": "sequential",
  "actions": [
    {
      "send": {
        "text": "Load a."
      }
    },
    {
      "wait": "idle"
    },
    {
      "send": {
        "text": "Load b."
      }
    },
    {
      "wait": "idle"
    },
    {
      "compact": {
        "from": "turn_02"
      }
    },
    {
      "send": {
        "text": "Next."
      }
    },
    {
      "wait": "idle"
    }
  ]
}
