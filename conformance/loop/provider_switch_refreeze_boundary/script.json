{
  "spec_version": "0.5",
  "description": "Switching to a declared prefix-bound model opens an epoch with boundary switch: the system prompt is kept, the tools are frozen anew, and every earlier line is carried over as a copy.",
  "agent": {
    "nickname": "Tater",
    "instructions": "Be brief.",
    "tools": [
      {
        "name": "echo",
        "description": "Echo the text back.",
        "input_schema": {
          "type": "object",
          "properties": {
            "text": {
              "type": "string"
            }
          },
          "required": [
            "text"
          ]
        },
        "concurrency": "serial",
        "behavior": {
          "type": "echo"
        }
      }
    ],
    "capabilities": [
      {
        "api": "anthropic.messages",
        "model_glob": "claude-opus-5-5*",
        "caps": {
          "thinking_prefix_bound": true
        }
      }
    ]
  },
  "providers": [
    {
      "name": "gpt",
      "api": "openai.responses",
      "model": "gpt-5.6",
      "responses": [
        "responses/01.sse"
      ],
      "params": {
        "reasoning": {
          "effort": "low"
        }
      }
    },
    {
      "name": "claude",
      "api": "anthropic.messages",
      "model": "claude-opus-5-5",
      "responses": [
        "responses/02.sse"
      ]
    }
  ],
  "clock": {
    "start": "2026-09-26T00:00:00.000Z",
    "step_ms": 1
  },
  "ids": "sequential",
  "actions": [
    {
      "send": {
        "text": "Hi."
      }
    },
    {
      "wait": "idle"
    },
    {
      "add_tool": {
        "name": "extra",
        "description": "A tool added mid-epoch.",
        "input_schema": {
          "type": "object"
        },
        "concurrency": "parallel",
        "behavior": {
          "type": "fixed",
          "text": "extra"
        }
      }
    },
    {
      "switch_model": {
        "provider": "claude"
      }
    },
    {
      "send": {
        "text": "Still there?"
      }
    },
    {
      "wait": "idle"
    }
  ]
}
