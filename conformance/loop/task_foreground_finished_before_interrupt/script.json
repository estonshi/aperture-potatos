{
  "spec_version": "0.3",
  "description": "A foreground job ends while a parallel call in its batch still runs, and then the turn is interrupted: the start call keeps the job's real result, the job stays succeeded, and no notification follows. A task_start hook holds the job's start for 1 ms of virtual time, so its task events follow the sibling call's tool.started, which a parallel group otherwise leaves unordered; the clock is interleaved because the hook and the sibling call still take timestamps in no fixed order.",
  "agent": {
    "nickname": "Tater",
    "instructions": "Be brief.",
    "tools": [
      {
        "name": "slow_lookup",
        "description": "Look something up; it takes a while.",
        "input_schema": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string"
            }
          },
          "required": [
            "query"
          ]
        },
        "concurrency": "parallel",
        "behavior": {
          "type": "fixed",
          "text": "Found it.",
          "sleep_ms": 1000
        }
      }
    ],
    "task_kinds": [
      {
        "name": "job",
        "caps": {},
        "start_tool": {
          "name": "start_job",
          "description": "Start a job.",
          "input_schema": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string"
              }
            },
            "required": [
              "title"
            ]
          }
        }
      }
    ],
    "hooks": [
      {
        "point": "task_start",
        "name": "settle",
        "match": "job",
        "calls": [
          {
            "sleep_ms": 1
          }
        ]
      }
    ]
  },
  "providers": [
    {
      "name": "claude",
      "api": "anthropic.messages",
      "model": "claude-opus-5-5",
      "responses": [
        "responses/01.sse"
      ]
    }
  ],
  "clock": {
    "start": "2026-09-29T00:00:00.000Z",
    "step_ms": 1,
    "interleaved": true
  },
  "ids": "sequential",
  "actions": [
    {
      "send": {
        "text": "Count the rows."
      }
    },
    {
      "wait": {
        "event": "task.started"
      }
    },
    {
      "task": {
        "step": "task_01",
        "do": {
          "succeed": "42 rows."
        }
      }
    },
    {
      "wait": {
        "event": "task.finished"
      }
    },
    {
      "interrupt": {
        "reason": "stop"
      }
    },
    {
      "wait": "idle"
    },
    {
      "task": {
        "get": "task_01"
      }
    },
    {
      "wait_quiet": true
    }
  ]
}
