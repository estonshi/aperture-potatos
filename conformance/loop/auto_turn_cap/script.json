{
  "spec_version": "0.5",
  "description": "Turns fed only by reminders stop at max_consecutive_auto_turns; the reminder over the cap waits and rides the next human turn, which resets the count.",
  "agent": {
    "nickname": "Tater",
    "instructions": "Be brief.",
    "tools": [],
    "limits": {
      "max_consecutive_auto_turns": 2
    }
  },
