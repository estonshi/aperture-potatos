{
  "spec_version": "0.1",
  "description": "BackgroundCall refuses a call of a tool not declared Background, an unknown call, and a Background call that has already returned; each call keeps its own result.",
  "agent": {
    "nickname": "Tater",
    "instructions": "Be brief.",
    "tools": [
      {
        "name": "lint",
        "description": "Run the linter.",
        "input_schema": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            }
          },
          "required": [
            "path"
          ]
        },
        "behavior": {
          "type": "fixed",
          "text": "lint clean",
          "sleep_ms": 3000
        }
      },
      {
        "name": "run_build",
        "description": "Run the build.",
        "input_schema": {
          "type": "object",
          "properties": {
            "target": {
              "type": "string"
            }
          },
          "required": [
            "target"
          ]
        },
        "background": true,
        "behavior": {
          "type": "echo",
          "sleep_ms": 1000
        }
      }
    ]
  },
  "providers": [
    {
      "name": "claude",
      "api": "anthropic.messages",
      "model": "claude-opus-5-5",
      "responses": [
        "responses/01.sse",
        "responses/02.sse",
        "responses/03.sse"
      ]
    }
  ],
  "clock": {
    "start": "2026-10-15T00:00:00.000Z",
    "step_ms": 1,
    "interleaved": true
  },
  "ids": "sequential",
  "actions": [
    {
      "send": {
        "text": "Lint, then build."
      }
    },
    {
      "wait": {
        "event": "tool.started",
        "where": {
          "call_id": "toolu_01"
        }
      }
    },
    {
      "background_call": "toolu_01",
      "error": "no movable call"
    },
    {
      "background_call": "toolu_09",
      "error": "no movable call"
    },
    {
      "wait": {
        "event": "tool.completed",
        "where": {
          "call_id": "toolu_02"
        }
      }
    },
    {
      "background_call": "toolu_02",
      "error": "no movable call"
    },
    {
      "wait_quiet": true
    }
  ]
}
