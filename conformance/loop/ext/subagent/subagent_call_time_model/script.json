{
  "spec_version": "0.2",
  "description": "A call names a model and an effort the host exposes: the child session runs on the model the host resolves for that name, with the reasoning effort the call asked for, and the parent goes on with its own.",
  "agent": {
    "nickname": "Tater",
    "instructions": "Be brief.",
    "tools": [
      {
        "name": "lookup",
        "description": "Look up a fact.",
        "input_schema": {
          "type": "object",
          "properties": {
            "q": {
              "type": "string"
            }
          },
          "required": [
            "q"
          ]
        },
        "concurrency": "parallel",
        "behavior": {
          "type": "fixed",
          "text": "Paris is the capital of France."
        }
      }
    ],
    "extensions": {
      "subagent": {
        "defs": [
          {
            "name": "researcher",
            "description": "Looks facts up.",
            "instructions": "Answer in as few words as possible."
          }
        ],
        "models": [
          "small",
          "inherit"
        ],
        "efforts": [
          "low",
          "high"
        ],
        "resolve_model": {
          "small": {
            "provider": "small",
            "model": "claude-small"
          }
        }
      }
    }
  },
  "providers": [
    {
      "name": "claude",
      "api": "anthropic.messages",
      "model": "claude-opus-5-5",
      "responses": [
        "responses/01.sse",
        "responses/03.sse"
      ]
    },
    {
      "name": "small",
      "api": "anthropic.messages",
      "model": "claude-small",
      "responses": [
        "responses/02.sse"
      ]
    }
  ],
  "clock": {
    "start": "2026-09-29T00:00:00.000Z",
    "step_ms": 1,
    "interleaved": true
  },
  "ids": "sequential",
  "actions": [
    {
      "send": {
        "text": "Ask a researcher for the capital of France with the small model and high effort."
      }
    },
    {
      "wait_quiet": true
    }
  ]
}
