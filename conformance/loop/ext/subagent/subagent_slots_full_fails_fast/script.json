{
  "spec_version": "0.3",
  "description": "With one slot per session, a second subagent started while the first one waits for an answer fails at once instead of queueing; the first one still finishes once answered. A post_tool_use hook holds the first start call's result for 1 ms of virtual time and the child's first reply holds for 5 ms, so the child takes its message ids before the parent's tool line and its forwarded usage and question follow the parent's first turn, which O4 otherwise leaves unordered.",
  "agent": {
    "nickname": "Tater",
    "instructions": "Be brief.",
    "tools": [
      {
        "name": "lookup",
        "description": "Look up a fact.",
        "input_schema": {
          "type": "object",
          "properties": {
            "q": {
              "type": "string"
            }
          },
          "required": [
            "q"
          ]
        },
        "concurrency": "parallel",
        "behavior": {
          "type": "fixed",
          "text": "Paris is the capital of France."
        }
      }
    ],
    "extensions": {
      "subagent": {
        "defs": [
          {
            "name": "researcher",
            "description": "Looks facts up.",
            "instructions": "Answer in as few words as possible."
          }
        ],
        "max_concurrent": 1
      }
    },
    "hooks": [
      {
        "point": "post_tool_use",
        "name": "settle",
        "match": "subagent",
        "cases": [
          {
            "when": {
              "call.id": "toolu_01"
            },
            "call": {
              "sleep_ms": 1
            }
          }
        ]
      }
    ],
    "limits": {
      "max_steps": 1
    }
  },
  "providers": [
    {
      "name": "claude",
      "api": "anthropic.messages",
      "model": "claude-opus-5-5",
      "responses": [
        "responses/01.sse",
        {
          "sse": "responses/02.sse",
          "hold_after_events": 1,
          "hold_ms": 5
        },
        "responses/03.sse",
        "responses/04.sse",
        "responses/05.sse"
      ]
    }
  ],
  "clock": {
    "start": "2026-09-29T00:00:00.000Z",
    "step_ms": 1,
    "interleaved": true
  },
  "ids": "sequential",
  "actions": [
    {
      "send": {
        "text": "Pick a logo color in the background."
      }
    },
    {
      "wait": {
        "event": "turn.completed",
        "where": {
          "turn_id": "turn_03"
        }
      }
    },
    {
      "task": {
        "send": "task_01",
        "text": "Blue."
      }
    },
    {
      "wait_quiet": true
    }
  ]
}
