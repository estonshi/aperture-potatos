{
  "spec_version": "0.1",
  "description": "A message to a finished subagent continues it in the same child session: the kernel binds the open child to the new attempt, the child sees the message as another agent's and keeps its history, and the end of the continuation is notified.",
  "agent": {
    "nickname": "Tater",
    "instructions": "Be brief.",
    "tools": [
      {
        "name": "lookup",
        "description": "Look up a fact.",
        "input_schema": {
          "type": "object",
          "properties": {
            "q": {
              "type": "string"
            }
          },
          "required": [
            "q"
          ]
        },
        "concurrency": "parallel",
        "behavior": {
          "type": "fixed",
          "text": "Paris is the capital of France."
        }
      }
    ],
    "extensions": {
      "subagent": {
        "defs": [
          {
            "name": "researcher",
            "description": "Looks facts up.",
            "instructions": "Answer in as few words as possible."
          }
        ]
      }
    }
  },
  "providers": [
    {
      "name": "claude",
      "api": "anthropic.messages",
      "model": "claude-opus-5-5",
      "responses": [
        "responses/01.sse",
        "responses/02.sse",
        "responses/03.sse",
        "responses/04.sse",
        "responses/05.sse"
      ]
    }
  ],
  "clock": {
    "start": "2026-09-29T00:00:00.000Z",
    "step_ms": 1,
    "interleaved": true
  },
  "ids": "sequential",
  "actions": [
    {
      "send": {
        "text": "Ask a researcher for the capital of France."
      }
    },
    {
      "wait": "idle"
    },
    {
      "task": {
        "send": "task_01",
        "text": "And of Germany?"
      }
    },
    {
      "wait_quiet": true
    }
  ]
}
