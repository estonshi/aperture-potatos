{
  "spec_version": "0.2",
  "description": "A subagent never gets the subagent tool, even when its definition lists it, so it cannot delegate again; its other tools are exactly the ones Tools lists from the parent's, and without ask_parent in that list it has no ask_parent either.",
  "agent": {
    "nickname": "Tater",
    "instructions": "Be brief.",
    "tools": [
      {
        "name": "lookup",
        "description": "Look up a fact.",
        "input_schema": {
          "type": "object",
          "properties": {
            "q": {
              "type": "string"
            }
          },
          "required": [
            "q"
          ]
        },
        "concurrency": "parallel",
        "behavior": {
          "type": "fixed",
          "text": "Paris is the capital of France."
        }
      },
      {
        "name": "write",
        "description": "Write a file.",
        "input_schema": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            }
          }
        },
        "behavior": {
          "type": "fixed",
          "text": "written"
        }
      }
    ],
    "extensions": {
      "subagent": {
        "defs": [
          {
            "name": "reader",
            "description": "Reads things.",
            "tools": [
              "lookup",
              "subagent"
            ]
          }
        ]
      }
    }
  },
  "providers": [
    {
      "name": "claude",
      "api": "anthropic.messages",
      "model": "claude-opus-5-5",
      "responses": [
        "responses/01.sse",
        "responses/02.sse",
        "responses/03.sse"
      ]
    }
  ],
  "clock": {
    "start": "2026-09-29T00:00:00.000Z",
    "step_ms": 1,
    "interleaved": true
  },
  "ids": "sequential",
  "actions": [
    {
      "send": {
        "text": "Ask the reader what it can do."
      }
    },
    {
      "wait_quiet": true
    }
  ]
}
