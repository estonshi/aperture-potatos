{
  "spec_version": "0.1",
  "description": "Stopping a foreground subagent while its child is mid-request: the subagent's run interrupts the child's turn, waits for it to exit and closes the child, and every event the child produced, down to its session.closed, reaches the parent before task.finished and the call's canceled result.",
  "agent": {
    "nickname": "Tater",
    "instructions": "Be brief.",
    "tools": [
      {
        "name": "lookup",
        "description": "Look up a fact.",
        "input_schema": {
          "type": "object",
          "properties": {
            "q": {
              "type": "string"
            }
          },
          "required": [
            "q"
          ]
        },
        "concurrency": "parallel",
        "behavior": {
          "type": "fixed",
          "text": "Paris is the capital of France."
        }
      }
    ],
    "extensions": {
      "subagent": {
        "defs": [
          {
            "name": "researcher",
            "description": "Looks facts up.",
            "instructions": "Answer in as few words as possible."
          }
        ]
      }
    }
  },
  "providers": [
    {
      "name": "claude",
      "api": "anthropic.messages",
      "model": "claude-opus-5-5",
      "responses": [
        "responses/01.sse",
        {
          "sse": "responses/02.sse",
          "hold_after_events": 1
        },
        "responses/03.sse"
      ]
    }
  ],
  "clock": {
    "start": "2026-09-29T00:00:00.000Z",
    "step_ms": 1,
    "interleaved": true
  },
  "ids": "sequential",
  "actions": [
    {
      "send": {
        "text": "Ask a researcher for the capital of France."
      }
    },
    {
      "wait": {
        "event": "step.started",
        "count": 2
      }
    },
    {
      "task": {
        "stop": "task_01",
        "reason": "never mind"
      }
    },
    {
      "wait_quiet": true
    }
  ]
}
