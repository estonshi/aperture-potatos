{
  "spec_version": "0.2",
  "description": "A subagent that lacks what the parent's conversation holds finds it with search_history and parent: true, which searches the parent session's current context without interrupting it.",
  "agent": {
    "nickname": "Tater",
    "instructions": "Be brief.",
    "tools": [
      {
        "name": "lookup",
        "description": "Look up a fact.",
        "input_schema": {
          "type": "object",
          "properties": {
            "q": {
              "type": "string"
            }
          },
          "required": [
            "q"
          ]
        },
        "concurrency": "parallel",
        "behavior": {
          "type": "fixed",
          "text": "Paris is the capital of France."
        }
      }
    ],
    "extensions": {
      "subagent": {
        "defs": [
          {
            "name": "researcher",
            "description": "Looks facts up.",
            "instructions": "Answer in as few words as possible."
          }
        ]
      },
      "history": {}
    }
  },
  "providers": [
    {
      "name": "claude",
      "api": "anthropic.messages",
      "model": "claude-opus-5-5",
      "responses": [
        "responses/01.sse",
        "responses/02.sse",
        "responses/03.sse",
        "responses/04.sse",
        "responses/05.sse"
      ]
    }
  ],
  "clock": {
    "start": "2026-09-29T00:00:00.000Z",
    "step_ms": 1,
    "interleaved": true
  },
  "ids": "sequential",
  "actions": [
    {
      "send": {
        "text": "The meeting is in room 42."
      }
    },
    {
      "wait": "idle"
    },
    {
      "send": {
        "text": "Have a researcher find the meeting room."
      }
    },
    {
      "wait_quiet": true
    }
  ]
}
