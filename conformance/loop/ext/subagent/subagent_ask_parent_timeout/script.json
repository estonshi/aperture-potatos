{
  "spec_version": "0.4",
  "description": "With AskTimeout set, ask_parent withdraws the question when no answer arrives in time and tells the subagent to go on with its own judgment; the subagent finishes and the parent is notified.",
  "agent": {
    "nickname": "Tater",
    "instructions": "Be brief.",
    "tools": [
      {
        "name": "lookup",
        "description": "Look up a fact.",
        "input_schema": {
          "type": "object",
          "properties": {
            "q": {
              "type": "string"
            }
          },
          "required": [
            "q"
          ]
        },
        "concurrency": "parallel",
        "behavior": {
          "type": "fixed",
          "text": "Paris is the capital of France."
        }
      }
    ],
    "extensions": {
      "subagent": {
        "defs": [
          {
            "name": "researcher",
            "description": "Looks facts up.",
            "instructions": "Answer in as few words as possible.",
            "ask_timeout_ms": 500
          }
        ]
      }
    }
  },
  "providers": [
    {
      "name": "claude",
      "api": "anthropic.messages",
      "model": "claude-opus-5-5",
      "responses": [
        "responses/01.sse",
        "responses/02.sse",
        "responses/03.sse",
        "responses/04.sse",
        "responses/05.sse"
      ]
    }
  ],
  "clock": {
    "start": "2026-09-29T00:00:00.000Z",
    "step_ms": 1,
    "interleaved": true
  },
  "ids": "sequential",
  "actions": [
    {
      "send": {
        "text": "Have a researcher pick a logo color."
      }
    },
    {
      "wait_quiet": true
    }
  ]
}
