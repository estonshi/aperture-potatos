{
  "spec_version": "0.4",
  "description": "A background subagent's model calls are booked in the parent's ledger under the turn that started it, in the subagent bucket with the child's session id, alongside the parent's own call. While the subagent still runs after that turn ended, the turn's calls are pending. A post_tool_use hook holds the start call's result for 1 ms of virtual time, so the child takes its message ids before the parent's tool line does, which O4 otherwise leaves unordered.",
  "agent": {
    "nickname": "Tater",
    "instructions": "Be brief.",
    "tools": [
      {
        "name": "lookup",
        "description": "Look up a fact.",
        "input_schema": {
          "type": "object",
          "properties": {
            "q": {
              "type": "string"
            }
          },
          "required": [
            "q"
          ]
        },
        "concurrency": "parallel",
        "behavior": {
          "type": "fixed",
          "text": "Paris is the capital of France."
        }
      }
    ],
    "extensions": {
      "subagent": {
        "defs": [
          {
            "name": "researcher",
            "description": "Looks facts up.",
            "instructions": "Answer in as few words as possible."
          }
        ]
      }
    },
    "hooks": [
      {
        "point": "post_tool_use",
        "name": "settle",
        "match": "subagent",
        "calls": [
          {
            "sleep_ms": 1
          }
        ]
      }
    ],
    "limits": {
      "max_steps": 1
    }
  },
  "providers": [
    {
      "name": "claude",
      "api": "anthropic.messages",
      "model": "claude-opus-5-5",
      "responses": [
        "responses/01.sse",
        {
          "sse": "responses/02.sse",
          "hold_after_events": 1,
          "hold_ms": 500
        },
        "responses/03.sse",
        "responses/04.sse"
      ]
    }
  ],
  "clock": {
    "start": "2026-09-29T00:00:00.000Z",
    "step_ms": 1,
    "interleaved": true
  },
  "ids": "sequential",
  "actions": [
    {
      "send": {
        "text": "Ask a researcher for the capital of France in the background."
      }
    },
    {
      "wait": {
        "event": "turn.completed",
        "where": {
          "turn_id": "turn_01"
        }
      }
    },
    {
      "ledger": {
        "turn": "turn_01"
      }
    },
    {
      "wait_quiet": true
    },
    {
      "ledger": {
        "turn": "turn_01"
      }
    }
  ]
}
