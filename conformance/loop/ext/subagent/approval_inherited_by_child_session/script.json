{
  "spec_version": "0.2",
  "description": "The parent agent's approval rule and reviewer apply in the child session: the subagent's call is reviewed by the same reviewer, whose request carries the task hop in its path, and the review's events arrive under that hop.",
  "agent": {
    "nickname": "Tater",
    "instructions": "Be brief.",
    "tools": [
      {
        "name": "lookup",
        "description": "Look up a fact.",
        "input_schema": {
          "type": "object",
          "properties": {
            "q": {
              "type": "string"
            }
          },
          "required": [
            "q"
          ]
        },
        "concurrency": "parallel",
        "behavior": {
          "type": "fixed",
          "text": "Paris is the capital of France."
        }
      }
    ],
    "extensions": {
      "subagent": {
        "defs": [
          {
            "name": "researcher",
            "description": "Looks facts up.",
            "instructions": "Answer in as few words as possible."
          }
        ]
      }
    },
    "hooks": [
      {
        "point": "approval",
        "name": "ui",
        "calls": [
          {
            "output": {
              "verdict": "approve"
            }
          }
        ]
      }
    ],
    "approval_rules": [
      {
        "id": "ask-lookup",
        "tool": "lookup",
        "action": "ask",
        "reason": "lookups are reviewed"
      }
    ]
  },
  "providers": [
    {
      "name": "claude",
      "api": "anthropic.messages",
      "model": "claude-opus-5-5",
      "responses": [
        "responses/01.sse",
        "responses/02.sse",
        "responses/03.sse",
        "responses/04.sse"
      ]
    }
  ],
  "clock": {
    "start": "2026-09-29T00:00:00.000Z",
    "step_ms": 1,
    "interleaved": true
  },
  "ids": "sequential",
  "actions": [
    {
      "send": {
        "text": "Ask a researcher for the capital of France."
      }
    },
    {
      "wait_quiet": true
    }
  ]
}
