{
  "spec_version": "0.3",
  "description": "Summarize up to a turn when the model answers with an empty summary: the compaction fails and the history stays as it was, so the next request still carries every turn.",
  "agent": {
    "nickname": "Tater",
    "instructions": "Be brief.",
    "tools": [],
    "context_policy": {
      "max_context_tokens": 68000
    },
    "extensions": {
      "compact": {}
    }
  },
  "providers": [
    {
      "name": "claude",
      "api": "anthropic.messages",
      "model": "claude-opus-5-5",
      "responses": [
        "responses/01.sse",
        "responses/02.sse",
        "responses/03.sse",
        "responses/04.sse",
        "responses/05.sse"
      ]
    }
  ],
  "clock": {
    "start": "2026-09-26T00:00:00.000Z",
    "step_ms": 1
  },
  "ids": "sequential",
  "actions": [
    {
      "send": {
        "text": "First question."
      }
    },
    {
      "wait": "idle"
    },
    {
      "send": {
        "text": "Second question."
      }
    },
    {
      "wait": "idle"
    },
    {
      "send": {
        "text": "Third question."
      }
    },
    {
      "wait": "idle"
    },
    {
      "compact": {
        "up_to": "turn_03"
      },
      "error": "empty summary"
    },
    {
      "send": {
        "text": "Fourth question."
      }
    },
    {
      "wait": "idle"
    }
  ]
}
