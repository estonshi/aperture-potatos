{
  "spec_version": "0.5",
  "description": "On a prefix-bound model the default strategy keeps no original line, not even the running turn: the new epoch is the rebuilt head and the continue reminder.",
  "agent": {
    "nickname": "Tater",
    "instructions": "Be brief.",
    "tools": [
      {
        "name": "echo",
        "description": "Echo the text back.",
        "input_schema": {
          "type": "object",
          "properties": {
            "text": {
              "type": "string"
            }
          },
          "required": [
            "text"
          ]
        },
        "concurrency": "serial",
        "behavior": {
          "type": "echo"
        }
      }
    ],
    "context_policy": {
      "max_context_tokens": 68000
    },
    "capabilities": [
      {
        "api": "anthropic.messages",
        "model_glob": "claude-opus-5-5",
        "caps": {
          "thinking_prefix_bound": true
        }
      }
    ],
    "extensions": {
      "compact": {}
    }
  },
  "providers": [
    {
      "name": "claude",
      "api": "anthropic.messages",
      "model": "claude-opus-5-5",
      "responses": [
        "responses/01.sse",
        "responses/02.sse",
        "responses/03.sse",
        "responses/04.sse",
        "responses/05.sse"
      ]
    }
  ],
  "clock": {
    "start": "2026-09-26T00:00:00.000Z",
    "step_ms": 1
  },
  "ids": "sequential",
  "actions": [
    {
      "send": {
        "text": "Echo hi."
      }
    },
    {
      "wait": "idle"
    },
    {
      "send": {
        "text": "Echo it again, then tell me."
      }
    },
    {
      "wait": "idle"
    }
  ]
}
