{
  "spec_version": "0.2",
  "description": "A custom summary template replaces the default; once the epoch starts from an earlier summary, the fixed carry-forward sentence follows the template, so the earlier summary is not lost.",
  "agent": {
    "nickname": "Tater",
    "instructions": "Be brief.",
    "tools": [],
    "context_policy": {
      "max_context_tokens": 68000
    },
    "extensions": {
      "compact": {
        "summary_prompt": "List the questions asked so far, one per line, in at most {{target}} tokens."
      }
    }
  },
  "providers": [
    {
      "name": "claude",
      "api": "anthropic.messages",
      "model": "claude-opus-5-5",
      "responses": [
        "responses/01.sse",
        "responses/02.sse",
        "responses/03.sse",
        "responses/04.sse",
        "responses/05.sse",
        "responses/06.sse"
      ]
    }
  ],
  "clock": {
    "start": "2026-09-26T00:00:00.000Z",
    "step_ms": 1
  },
  "ids": "sequential",
  "actions": [
    {
      "send": {
        "text": "First question."
      }
    },
    {
      "wait": "idle"
    },
    {
      "send": {
        "text": "Second question."
      }
    },
    {
      "wait": "idle"
    },
    {
      "compact": {}
    },
    {
      "send": {
        "text": "Third question."
      }
    },
    {
      "wait": "idle"
    },
    {
      "send": {
        "text": "Fourth question."
      }
    },
    {
      "wait": "idle"
    },
    {
      "compact": {}
    }
  ]
}
