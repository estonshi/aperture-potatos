{
  "spec_version": "0.4",
  "description": "The peer asks for input: the foreground call returns its question and the task waits; the host's answer goes to the same remote task, and the end is notified.",
  "agent": {
    "nickname": "Tater",
    "instructions": "Be brief.",
    "extensions": {
      "peer": {
        "peers": [
          {
            "name": "translator",
            "description": "Translates text between languages.",
            "skills": [
              {
                "id": "fr",
                "name": "French",
                "description": "English to French."
              }
            ],
            "rounds": [
              {
                "events": [
                  {
                    "kind": "task",
                    "task_id": "t-1",
                    "context_id": "c-1",
                    "state": "submitted"
                  },
                  {
                    "kind": "status",
                    "task_id": "t-1",
                    "context_id": "c-1",
                    "state": "input_required",
                    "message": {
                      "message_id": "s-t-1-input_required",
                      "role": "agent",
                      "parts": [
                        {
                          "text": "Which language?"
                        }
                      ]
                    }
                  }
                ]
              },
              {
                "events": [
                  {
                    "kind": "status",
                    "task_id": "t-1",
                    "context_id": "c-1",
                    "state": "working"
                  },
                  {
                    "kind": "artifact",
                    "task_id": "t-1",
                    "context_id": "c-1",
                    "artifact": {
                      "artifact_id": "a-t-1",
                      "parts": [
                        {
                          "text": "Hola ({{text}}, task {{task_id}})"
                        }
                      ]
                    },
                    "last_chunk": true
                  },
                  {
                    "kind": "status",
                    "task_id": "t-1",
                    "context_id": "c-1",
                    "state": "completed"
                  }
                ]
              }
            ]
          }
        ]
      }
    }
  },
  "providers": [
    {
      "name": "claude",
      "api": "anthropic.messages",
      "model": "claude-opus-5-5",
      "responses": [
        "responses/01.sse",
        "responses/02.sse",
        "responses/03.sse"
      ]
    }
  ],
  "clock": {
    "start": "2026-10-02T00:00:00.000Z",
    "step_ms": 1,
    "interleaved": true
  },
  "ids": "sequential",
  "actions": [
    {
      "send": {
        "text": "Translate hello."
      }
    },
    {
      "wait": "idle"
    },
    {
      "task": {
        "send": "task_01",
        "text": "Spanish."
      }
    },
    {
      "wait_quiet": true
    }
  ]
}
