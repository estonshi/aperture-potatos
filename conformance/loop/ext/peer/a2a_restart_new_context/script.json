{
  "spec_version": "0.3",
  "description": "A restart starts a new conversation with the original message.",
  "agent": {
    "nickname": "Tater",
    "instructions": "Be brief.",
    "extensions": {
      "peer": {
        "peers": [
          {
            "name": "translator",
            "description": "Translates text between languages.",
            "skills": [
              {
                "id": "fr",
                "name": "French",
                "description": "English to French."
              }
            ],
            "rounds": [
              {
                "events": [
                  {
                    "kind": "task",
                    "task_id": "t-1",
                    "context_id": "c-1",
                    "state": "submitted"
                  },
                  {
                    "kind": "artifact",
                    "task_id": "t-1",
                    "context_id": "c-1",
                    "artifact": {
                      "artifact_id": "a-t-1",
                      "parts": [
                        {
                          "text": "Hello."
                        }
                      ]
                    },
                    "last_chunk": true
                  },
                  {
                    "kind": "status",
                    "task_id": "t-1",
                    "context_id": "c-1",
                    "state": "completed"
                  }
                ]
              },
              {
                "events": [
                  {
                    "kind": "task",
                    "task_id": "t-2",
                    "context_id": "c-2",
                    "state": "submitted"
                  },
                  {
                    "kind": "artifact",
                    "task_id": "t-2",
                    "context_id": "c-2",
                    "artifact": {
                      "artifact_id": "a-t-2",
                      "parts": [
                        {
                          "text": "context=[{{context_id}}]: {{text}}"
                        }
                      ]
                    },
                    "last_chunk": true
                  },
                  {
                    "kind": "status",
                    "task_id": "t-2",
                    "context_id": "c-2",
                    "state": "completed"
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    "hooks": [
      {
        "point": "task_notify",
        "name": "quiet",
        "calls": [
          {
            "output": {
              "no_wake": true
            }
          }
        ]
      }
    ]
  },
  "providers": [
    {
      "name": "claude",
      "api": "anthropic.messages",
      "model": "claude-opus-5-5",
      "responses": [
        "responses/01.sse"
      ]
    }
  ],
  "clock": {
    "start": "2026-10-02T00:00:00.000Z",
    "step_ms": 1,
    "interleaved": true
  },
  "ids": "sequential",
  "actions": [
    {
      "send": {
        "text": "Hello."
      }
    },
    {
      "wait": "idle"
    },
    {
      "task": {
        "start": {
          "kind": "a2a",
          "title": "translator: Say hello",
          "input": {
            "agent": "translator",
            "message": "Say hello"
          }
        }
      }
    },
    {
      "task": {
        "wait": "task_01"
      }
    },
    {
      "task": {
        "restart": "task_01"
      }
    },
    {
      "task": {
        "wait": "task_01"
      }
    }
  ]
}
