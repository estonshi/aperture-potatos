{
  "spec_version": "0.5",
  "description": "A user command expands $ARGUMENTS first and then rewrites the body; the command input and the pinned body hold the rewritten text, which compaction re-injects.",
  "agent": {
    "nickname": "Tater",
    "instructions": "Be brief.",
    "tools": [],
    "extensions": {
      "skills": {
        "files": {
          "release-notes/SKILL.md": "---\nname: release-notes\ndescription: Draft release notes.\nargument-hint: \"[version]\"\ndisable-model-invocation: true\n---\nWrite release notes for version $ARGUMENTS.\n\n!`git status`\n"
        },
        "rewrite": {
          "replace": [
            {
              "old": "!`git status`",
              "new": "working tree clean"
            }
          ]
        }
      }
    },
    "compactor": {
      "summary": "Release notes were drafted.",
      "keep": "none"
    }
  },
  "providers": [
    {
      "name": "claude",
      "api": "anthropic.messages",
      "model": "claude-opus-5-5",
      "responses": [
        "responses/01.sse",
        "responses/02.sse"
      ]
    }
  ],
  "clock": {
    "start": "2026-10-31T00:00:00.000Z",
    "step_ms": 1
  },
  "ids": "sequential",
  "actions": [
    {
      "command": {
        "name": "release-notes",
        "args": "2.1"
      }
    },
    {
      "wait": "idle"
    },
    {
      "compact": {}
    },
    {
      "send": {
        "text": "Next."
      }
    },
    {
      "wait": "idle"
    }
  ]
}
