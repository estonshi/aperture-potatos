{
  "spec_version": "0.5",
  "description": "/fork 1 copies what came before the last turn; the fork, resumed, goes on from there.",
  "agent": {
    "nickname": "Tater",
    "instructions": "Be brief.",
    "tools": [],
    "extensions": {
      "cmd.fork": {}
    }
  },
  "providers": [
    {
      "name": "claude",
      "api": "anthropic.messages",
      "model": "claude-opus-5-5",
      "responses": [
        "responses/01.sse",
        "responses/02.sse",
        "responses/03.sse"
      ]
    }
  ],
  "clock": {
    "start": "2026-09-26T00:00:00.000Z",
    "step_ms": 1
  },
  "ids": "sequential",
  "actions": [
    {
      "send": {
        "text": "First question."
      }
    },
    {
      "wait": "idle"
    },
    {
      "send": {
        "text": "Second question."
      }
    },
    {
      "wait": "idle"
    },
    {
      "command": {
        "name": "fork",
        "args": "1"
      }
    },
    {
      "wait": {
        "event": "command.completed",
        "count": 1
      }
    },
    {
      "resume": "ses_02",
      "as": "f"
    },
    {
      "send": {
        "text": "Continue from the first answer."
      },
      "on": "f"
    },
    {
      "wait": "idle",
      "on": "f"
    }
  ]
}
