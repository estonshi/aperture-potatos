{
  "spec_version": "0.4",
  "description": "A tool asks for input and no mcp_elicitation hook is registered: the request is declined, the server gets that action, and mcp.elicitation reports decline.",
  "agent": {
    "nickname": "Tater",
    "instructions": "Be brief.",
    "tools": [],
    "extensions": {
      "mcp": {
        "servers": [
          {
            "name": "greeter",
            "tools": [
              {
                "name": "ask",
                "description": "Ask whom to greet.",
                "elicit": {
                  "mode": "form",
                  "message": "Whom should I greet?",
                  "schema": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "name"
                    ]
                  }
                }
              }
            ]
          }
        ]
      }
    }
  },
  "providers": [
    {
      "name": "claude",
      "api": "anthropic.messages",
      "model": "claude-opus-5-5",
      "responses": [
        "responses/01.sse",
        "responses/02.sse"
      ]
    }
  ],
  "clock": {
    "start": "2026-10-28T00:00:00.000Z",
    "step_ms": 1
  },
  "ids": "sequential",
  "actions": [
    {
      "send": {
        "text": "Ask whom to greet."
      }
    },
    {
      "wait": "idle"
    }
  ]
}
