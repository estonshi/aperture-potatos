{
  "spec_version": "0.2",
  "description": "Anthropic, then Responses, then Chat, then Anthropic again: each API gets the whole history with only what it can replay, and each switch counts what it leaves out.",
  "agent": {
    "nickname": "Tater",
    "instructions": "Be brief.",
    "tools": [
      {
        "name": "echo",
        "description": "Echo the text back.",
        "input_schema": {
          "type": "object",
          "properties": {
            "text": {
              "type": "string"
            }
          },
          "required": [
            "text"
          ]
        },
        "concurrency": "serial",
        "behavior": {
          "type": "echo"
        }
      }
    ]
  },
  "providers": [
    {
      "name": "claude",
      "api": "anthropic.messages",
      "model": "claude-opus-5-5",
      "responses": [
        "responses/01.sse",
        "responses/02.sse",
        "responses/07.sse"
      ]
    },
    {
      "name": "gpt",
      "api": "openai.responses",
      "model": "gpt-5.6",
      "responses": [
        "responses/03.sse",
        "responses/04.sse"
      ],
      "params": {
        "reasoning": {
          "effort": "low"
        }
      }
    },
    {
      "name": "ds",
      "api": "openai.chat",
      "model": "deepseek-v4.1-flash",
      "responses": [
        "responses/05.sse",
        "responses/06.sse"
      ]
    }
  ],
  "clock": {
    "start": "2026-09-26T00:00:00.000Z",
    "step_ms": 1
  },
  "ids": "sequential",
  "actions": [
    {
      "send": {
        "text": "Echo one."
      }
    },
    {
      "wait": "idle"
    },
    {
      "switch_model": {
        "provider": "gpt"
      }
    },
    {
      "send": {
        "text": "Echo two."
      }
    },
    {
      "wait": "idle"
    },
    {
      "switch_model": {
        "provider": "ds"
      }
    },
    {
      "send": {
        "text": "Echo three."
      }
    },
    {
      "wait": "idle"
    },
    {
      "switch_model": {
        "provider": "claude"
      }
    },
    {
      "send": {
        "text": "Sum up."
      }
    },
    {
      "wait": "idle"
    }
  ]
}
