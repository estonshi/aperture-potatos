{
  "spec_version": "0.2",
  "description": "The host moves a running call of a Background tool to the background. The call settles at once with task_started (moved) and skips the loop's post_tool_use; a tool_exec task with the call's id takes the running execution over without running the tool again, reports its progress, runs post_tool_use once on the real result under the task hop, and its success is notified.",
  "agent": {
    "nickname": "Tater",
    "instructions": "Be brief.",
    "tools": [
      {
        "name": "run_build",
        "description": "Run the build.",
        "input_schema": {
          "type": "object",
          "properties": {
            "target": {
              "type": "string"
            }
          },
          "required": [
            "target"
          ]
        },
        "background": true,
        "behavior": {
          "type": "echo",
          "sleep_ms": 5000,
          "progress": [
            "compiling"
          ]
        }
      }
    ],
    "hooks": [
      {
        "point": "post_tool_use",
        "name": "audit"
      }
    ]
  },
  "providers": [
    {
      "name": "claude",
      "api": "anthropic.messages",
      "model": "claude-opus-5-5",
      "responses": [
        "responses/01.sse",
        "responses/02.sse",
        "responses/03.sse"
      ]
    }
  ],
  "clock": {
    "start": "2026-10-15T00:00:00.000Z",
    "step_ms": 1,
    "interleaved": true
  },
  "ids": "sequential",
  "actions": [
    {
      "send": {
        "text": "Build everything."
      }
    },
    {
      "wait": {
        "event": "tool.started",
        "where": {
          "call_id": "toolu_01"
        }
      }
    },
    {
      "background_call": "toolu_01"
    },
    {
      "wait_quiet": true
    }
  ]
}
