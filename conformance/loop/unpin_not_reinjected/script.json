{
  "spec_version": "0.2",
  "description": "Unpin takes a pin out of the set at once and tells the model with a reminder that rides the next turn; a compaction after it no longer re-injects the pin. Unpinning an unknown key fails.",
  "agent": {
    "nickname": "Tater",
    "instructions": "Be brief.",
    "tools": [
      {
        "name": "load_plan",
        "description": "Load load_plan.",
        "input_schema": {
          "type": "object"
        },
        "concurrency": "serial",
        "behavior": {
          "type": "fixed",
          "text": "Loaded.",
          "pin": {
            "key": "plan",
            "content": "Step 1 of 3: gather data."
          }
        }
      }
    ],
    "compactor": {
      "summary": "The plan was dropped.",
      "keep": "none"
    }
  },
  "providers": [
    {
      "name": "claude",
      "api": "anthropic.messages",
      "model": "claude-opus-5-5",
      "responses": [
        "responses/01.sse",
        "responses/02.sse",
        "responses/03.sse",
        "responses/04.sse"
      ]
    }
  ],
  "clock": {
    "start": "2026-09-26T00:00:00.000Z",
    "step_ms": 1
  },
  "ids": "sequential",
  "actions": [
    {
      "send": {
        "text": "Load the plan."
      }
    },
    {
      "wait": "idle"
    },
    {
      "unpin": "plan"
    },
    {
      "unpin": "nope",
      "error": "no pin"
    },
    {
      "send": {
        "text": "Continue."
      }
    },
    {
      "wait": "idle"
    },
    {
      "compact": {}
    },
    {
      "send": {
        "text": "Next."
      }
    },
    {
      "wait": "idle"
    }
  ]
}
