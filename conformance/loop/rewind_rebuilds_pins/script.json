{
  "spec_version": "0.4",
  "description": "A rewind rebuilds the pin set from the kept lines: a pin declared in a dropped turn is gone, so the next compaction re-injects only the earlier one.",
  "agent": {
    "nickname": "Tater",
    "instructions": "Be brief.",
    "tools": [
      {
        "name": "load_note",
        "description": "Load load_note.",
        "input_schema": {
          "type": "object"
        },
        "concurrency": "serial",
        "behavior": {
          "type": "fixed",
          "text": "Loaded.",
          "pin": {
            "key": "note",
            "content": "Use metric units."
          }
        }
      },
      {
        "name": "load_style",
        "description": "Load load_style.",
        "input_schema": {
          "type": "object"
        },
        "concurrency": "serial",
        "behavior": {
          "type": "fixed",
          "text": "Loaded.",
          "pin": {
            "key": "style",
            "content": "Answer in French."
          }
        }
      }
    ],
    "compactor": {
      "summary": "A note and a style were loaded.",
      "keep": "none"
    }
  },
  "providers": [
    {
      "name": "claude",
      "api": "anthropic.messages",
      "model": "claude-opus-5-5",
      "responses": [
        "responses/01.sse",
        "responses/02.sse",
        "responses/03.sse",
        "responses/04.sse",
        "responses/05.sse"
      ]
    }
  ],
  "clock": {
    "start": "2026-09-26T00:00:00.000Z",
    "step_ms": 1
  },
  "ids": "sequential",
  "actions": [
    {
      "send": {
        "text": "Load the note."
      }
    },
    {
      "wait": "idle"
    },
    {
      "send": {
        "text": "Load the style."
      }
    },
    {
      "wait": "idle"
    },
    {
      "rewind": "turn_02"
    },
    {
      "compact": {}
    },
    {
      "send": {
        "text": "Next."
      }
    },
    {
      "wait": "idle"
    }
  ]
}
