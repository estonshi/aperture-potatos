{
  "spec_version": "0.2",
  "description": "A queued next_loop input is withdrawn while a tool runs: it is dropped as withdrawn and never reaches the model, a second withdrawal fails, and the queue input still runs as its own turn.",
  "agent": {
    "nickname": "Tater",
    "instructions": "Be brief.",
    "tools": [
      {
        "name": "slow_lookup",
        "description": "Look something up; it takes a while.",
        "input_schema": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string"
            }
          },
          "required": [
            "query"
          ]
        },
        "concurrency": "serial",
        "behavior": {
          "type": "fixed",
          "text": "Found three options.",
          "sleep_ms": 1000
        }
      }
    ]
  },
  "providers": [
    {
      "name": "claude",
      "api": "anthropic.messages",
      "model": "claude-opus-5-5",
      "responses": [
        "responses/01.sse",
        "responses/02.sse",
        "responses/03.sse"
      ]
    }
  ],
  "clock": {
    "start": "2026-09-26T00:00:00.000Z",
    "step_ms": 1
  },
  "ids": "sequential",
  "actions": [
    {
      "send": {
        "text": "Plan Tokyo."
      }
    },
    {
      "wait": {
        "event": "tool.started",
        "count": 1
      }
    },
    {
      "send": {
        "text": "Write an English version too.",
        "mode": "queue"
      },
      "as": "english"
    },
    {
      "send": {
        "text": "Quote in yen."
      },
      "as": "yen"
    },
    {
      "withdraw": "yen"
    },
    {
      "withdraw": "yen",
      "error": "no queued input"
    },
    {
      "wait": "idle"
    },
    {
      "withdraw": "english",
      "error": "no queued input"
    }
  ]
}
