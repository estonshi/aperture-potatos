{
  "spec_version": "0.3",
  "description": "A restart with a new input passes the approval gate as a background call of the start tool: a rule that asks for review of that input makes the reviewer see it, and a denial leaves the current attempt running. Restarting with the approved input skips the gate.",
  "agent": {
    "nickname": "Tater",
    "instructions": "Be brief.",
    "tools": [
      {
        "name": "redo_job",
        "description": "Restart the job.",
        "input_schema": {
          "type": "object"
        },
        "concurrency": "serial",
        "behavior": {
          "type": "task_restart",
          "task": "task_01",
          "task_input": {
            "title": "Prod"
          }
        }
      }
    ],
    "task_kinds": [
      {
        "name": "job",
        "caps": {
          "restart": true
        },
        "start_tool": {
          "name": "start_job",
          "description": "Start a job.",
          "input_schema": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string"
              }
            },
            "required": [
              "title"
            ]
          }
        }
      }
    ],
    "approval_rules": [
      {
        "id": "prod-jobs",
        "tool": "start_job",
        "when": {
          "title": {
            "eq": "Prod"
          }
        },
        "action": "ask",
        "reason": "production job"
      }
    ],
    "hooks": [
      {
        "point": "approval",
        "name": "ops",
        "calls": [
          {
            "output": {
              "verdict": "deny",
              "reason": "not today"
            }
          }
        ]
      }
    ]
  },
  "providers": [
    {
      "name": "claude",
      "api": "anthropic.messages",
      "model": "claude-opus-5-5",
      "responses": [
        "responses/01.sse",
        "responses/02.sse",
        "responses/03.sse",
        "responses/04.sse",
        "responses/05.sse"
      ]
    }
  ],
  "clock": {
    "start": "2026-09-29T00:00:00.000Z",
    "step_ms": 1
  },
  "ids": "sequential",
  "actions": [
    {
      "send": {
        "text": "Start the staging job."
      }
    },
    {
      "wait": "idle"
    },
    {
      "send": {
        "text": "Run it on prod instead."
      }
    },
    {
      "wait": "idle"
    },
    {
      "task": {
        "restart": "task_01"
      }
    },
    {
      "task": {
        "step": "task_01",
        "do": {
          "succeed": "Staging done again."
        }
      }
    },
    {
      "wait_quiet": true
    }
  ]
}
