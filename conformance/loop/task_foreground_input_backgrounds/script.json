{
  "spec_version": "0.2",
  "description": "A foreground job asks for input: the call returns the question at once and the job goes on in the background. The host answers; when the job succeeds, its notification starts a turn.",
  "agent": {
    "nickname": "Tater",
    "instructions": "Be brief.",
    "tools": [],
