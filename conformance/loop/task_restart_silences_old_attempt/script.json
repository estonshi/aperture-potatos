{
  "spec_version": "0.2",
  "description": "A restart while the model is busy cancels the running attempt without a notification, withdraws the question that attempt left in the queue, and starts attempt 2 once the first has returned; only attempt 2's end is notified.",
  "agent": {
    "nickname": "Tater",
    "instructions": "Be brief.",
    "tools": [
      {
        "name": "slow",
        "description": "Takes a while.",
        "input_schema": {
          "type": "object"
        },
        "concurrency": "serial",
        "behavior": {
          "type": "fixed",
          "text": "slow done",
          "sleep_ms": 100
        }
      }
    ],
    "task_kinds": [
      {
        "name": "job",
        "caps": {
          "instructions": true,
          "restart": true
        }
      }
    ]
  },
  "providers": [
    {
      "name": "claude",
      "api": "anthropic.messages",
      "model": "claude-opus-5-5",
      "responses": [
        "responses/01.sse",
        "responses/02.sse",
        "responses/03.sse"
      ]
    }
  ],
  "clock": {
    "start": "2026-09-29T00:00:00.000Z",
    "step_ms": 1
  },
  "ids": "sequential",
  "actions": [
    {
      "task": {
        "start": {
          "kind": "job",
          "title": "Job",
          "input": {
            "title": "Job"
          }
        }
      }
    },
    {
      "send": {
        "text": "Run the slow tool."
      }
    },
    {
      "wait": {
        "event": "tool.started"
      }
    },
    {
      "task": {
        "step": "task_01",
        "do": {
          "ask": "Proceed?"
        }
      }
    },
    {
      "task": {
        "restart": "task_01",
        "input": {
          "title": "Job",
          "fast": true
        }
      }
    },
    {
      "wait": "idle"
    },
    {
      "task": {
        "step": "task_01",
        "do": {
          "succeed": "Second run done."
        }
      }
    },
    {
      "wait_quiet": true
    }
  ]
}
