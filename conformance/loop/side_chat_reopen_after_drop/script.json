{
  "spec_version": "0.2",
  "description": "A side chat is stored as <main>.side.<name>, whose calls also count in the main session's side bucket; dropping it writes a dropped boundary, after which it does not resume, and opening it again starts a new side_chat epoch of the same file, whose requests carry the main session as it is then.",
  "agent": {
    "nickname": "Tater",
    "instructions": "Be brief.",
    "tools": []
  },
  "providers": [
    {
      "name": "claude",
      "api": "anthropic.messages",
      "model": "claude-opus-5-5",
      "responses": [
        "responses/01.sse",
        "responses/02.sse",
        "responses/03.sse",
        "responses/04.sse"
      ]
    }
  ],
  "clock": {
    "start": "2026-09-26T00:00:00.000Z",
    "step_ms": 1
  },
  "ids": "sequential",
  "actions": [
    {
      "send": {
        "text": "Hello."
      }
    },
    {
      "wait": "idle"
    },
    {
      "side_chat": {
        "name": "notes",
        "as": "s1"
      }
    },
    {
      "send": {
        "text": "A side question."
      },
      "on": "s1"
    },
    {
      "wait": "idle",
      "on": "s1"
    },
    {
      "send": {
        "text": "Main goes on."
      }
    },
    {
      "wait": "idle"
    },
    {
      "drop_side_chat": "notes"
    },
    {
      "resume": "ses_01.side.notes",
      "error": "no stored session"
    },
    {
      "side_chat": {
        "name": "notes",
        "as": "s2"
      }
    },
    {
      "send": {
        "text": "Start over."
      },
      "on": "s2"
    },
    {
      "wait": "idle",
      "on": "s2"
    }
  ]
}
