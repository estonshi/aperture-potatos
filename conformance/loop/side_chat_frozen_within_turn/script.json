{
  "spec_version": "0.3",
  "description": "A side chat takes the main part once per turn: while its own tool runs the main session finishes its call, yet the side chat's next step still sends the main part with the placeholder result; its next turn carries the real result and says the main session changed.",
  "agent": {
    "nickname": "Tater",
    "instructions": "Be brief.",
    "tools": [
      {
        "name": "slow",
        "description": "Takes a while.",
        "input_schema": {
          "type": "object"
        },
        "concurrency": "serial",
        "behavior": {
          "type": "fixed",
          "text": "done",
          "sleep_ms": 500
        }
      },
      {
        "name": "wait",
        "description": "Waits longer.",
        "input_schema": {
          "type": "object"
        },
        "concurrency": "serial",
        "behavior": {
          "type": "fixed",
          "text": "waited",
          "sleep_ms": 1500
        }
      }
    ]
  },
  "providers": [
    {
      "name": "claude",
      "api": "anthropic.messages",
      "model": "claude-opus-5-5",
      "responses": [
        "responses/01.sse",
        "responses/02.sse",
        "responses/03.sse",
        "responses/04.sse",
        "responses/05.sse"
      ]
    }
  ],
  "clock": {
    "start": "2026-09-26T00:00:00.000Z",
    "step_ms": 1
  },
  "ids": "sequential",
  "actions": [
    {
      "send": {
        "text": "Run the slow tool."
      }
    },
    {
      "wait": {
        "event": "tool.started"
      }
    },
    {
      "side_chat": {
        "name": "s",
        "as": "s"
      }
    },
    {
      "send": {
        "text": "Wait, then tell me how the slow tool is doing."
      },
      "on": "s"
    },
    {
      "wait": "idle"
    },
    {
      "wait": "idle",
      "on": "s"
    },
    {
      "send": {
        "text": "And now?"
      },
      "on": "s"
    },
    {
      "wait": "idle",
      "on": "s"
    }
  ]
}
