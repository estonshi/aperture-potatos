{
  "spec_version": "0.4",
  "description": "On a declared prefix-bound model the history stays whole; the retry asks the API to drop mismatched thinking, which it reports.",
  "agent": {
    "nickname": "Tater",
    "instructions": "Be brief.",
    "tools": [
      {
        "name": "echo",
        "description": "Echo the text back.",
        "input_schema": {
          "type": "object",
          "properties": {
            "text": {
              "type": "string"
            }
          },
          "required": [
            "text"
          ]
        },
        "concurrency": "serial",
        "behavior": {
          "type": "echo"
        }
      }
    ],
    "capabilities": [
      {
        "api": "anthropic.messages",
        "model_glob": "claude-opus-5-5*",
        "caps": {
          "thinking_prefix_bound": true
        }
      }
    ]
  },
  "providers": [
    {
      "name": "claude",
      "api": "anthropic.messages",
      "model": "claude-opus-5-5",
      "responses": [
        "responses/01.sse",
        "responses/02.sse",
        {
          "sse": "responses/03.json",
          "status": 400,
          "headers": {
            "Content-Type": "application/json"
          }
        },
        "responses/04.sse"
      ]
    }
  ],
  "clock": {
    "start": "2026-09-26T00:00:00.000Z",
    "step_ms": 1
  },
  "ids": "sequential",
  "actions": [
    {
      "send": {
        "text": "Echo hi."
      }
    },
    {
      "wait": "idle"
    },
    {
      "send": {
        "text": "And now?"
      }
    },
    {
      "wait": "idle"
    }
  ]
}
