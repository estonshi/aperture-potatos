{
  "spec_version": "0.4",
  "description": "At max_running_tasks unfinished tasks, the host's start fails and the model's start gets an error result naming the limit; nothing is recorded for either.",
  "agent": {
    "nickname": "Tater",
    "instructions": "Be brief.",
    "tools": [],
    "task_kinds": [
      {
        "name": "job",
        "caps": {},
        "start_tool": {
          "name": "start_job",
          "description": "Start a job.",
          "input_schema": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string"
              }
            },
            "required": [
              "title"
            ]
          }
        }
      }
    ],
    "limits": {
      "max_running_tasks": 1
    }
  },
  "providers": [
    {
      "name": "claude",
      "api": "anthropic.messages",
      "model": "claude-opus-5-5",
      "responses": [
        "responses/01.sse",
        "responses/02.sse"
      ]
    }
  ],
  "clock": {
    "start": "2026-09-29T00:00:00.000Z",
    "step_ms": 1
  },
  "ids": "sequential",
  "actions": [
    {
      "task": {
        "start": {
          "kind": "job",
          "title": "First",
          "input": {
            "title": "First"
          }
        }
      }
    },
    {
      "task": {
        "start": {
          "kind": "job",
          "title": "Extra",
          "input": {}
        }
      },
      "error": "too many running tasks"
    },
    {
      "send": {
        "text": "Start a third job."
      }
    },
    {
      "wait": "idle"
    },
    {
      "task": {
        "list": true
      }
    }
  ]
}
