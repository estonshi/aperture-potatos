{
  "spec_version": "0.5",
  "description": "A post_tool_use hook rewrites the result the model and the events see and asks to stop; the batch is committed, the next_loop input waits, and the turn ends hook_stopped.",
  "agent": {
    "nickname": "Tater",
    "instructions": "Be brief.",
    "tools": [
      {
        "name": "echo",
        "description": "Echo the text back.",
        "input_schema": {
          "type": "object",
          "properties": {
            "text": {
              "type": "string"
            }
          },
          "required": [
            "text"
          ]
        },
        "concurrency": "serial",
        "behavior": {
          "type": "echo",
          "sleep_ms": 10
        }
      }
    ],
    "hooks": [
      {
        "point": "post_tool_use",
        "name": "redact",
        "calls": [
          {
            "output": {
              "updated_result": {
                "content": [
                  {
                    "type": "text",
                    "text": "[redacted]"
                  }
                ]
              },
              "stop_turn": true,
              "additional_context": "A result was redacted."
            }
          }
        ]
      }
    ]
  },
  "providers": [
    {
      "name": "claude",
      "api": "anthropic.messages",
      "model": "claude-opus-5-5",
      "responses": [
        "responses/01.sse",
        "responses/02.sse"
      ]
    }
  ],
  "clock": {
    "start": "2026-09-26T00:00:00.000Z",
    "step_ms": 1
  },
  "ids": "sequential",
  "actions": [
    {
      "send": {
        "text": "Echo the password."
      }
    },
    {
      "wait": {
        "event": "tool.started"
      }
    },
    {
      "send": {
        "text": "Also this.",
        "mode": "next_loop"
      }
    },
    {
      "wait": "idle"
    }
  ]
}
