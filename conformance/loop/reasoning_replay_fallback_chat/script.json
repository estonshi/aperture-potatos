{
  "spec_version": "0.3",
  "description": "A Chat server that refuses replayed reasoning fields makes the step retry once without any of them.",
  "agent": {
    "nickname": "Tater",
    "instructions": "Be brief.",
    "tools": [
      {
        "name": "echo",
        "description": "Echo the text back.",
        "input_schema": {
          "type": "object",
          "properties": {
            "text": {
              "type": "string"
            }
          },
          "required": [
            "text"
          ]
        },
        "concurrency": "serial",
        "behavior": {
          "type": "echo"
        }
      }
    ]
  },
  "providers": [
    {
      "name": "ds",
      "api": "openai.chat",
      "model": "deepseek-v4.1-flash",
      "responses": [
        "responses/01.sse",
        "responses/02.sse",
        {
          "sse": "responses/03.json",
          "status": 400,
          "headers": {
            "Content-Type": "application/json"
          }
        },
        "responses/04.sse"
      ]
    }
  ],
  "clock": {
    "start": "2026-09-26T00:00:00.000Z",
    "step_ms": 1
  },
  "ids": "sequential",
  "actions": [
    {
      "send": {
        "text": "Echo hi."
      }
    },
    {
      "wait": "idle"
    },
    {
      "send": {
        "text": "And now?"
      }
    },
    {
      "wait": "idle"
    }
  ]
}
