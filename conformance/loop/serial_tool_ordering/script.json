{
  "spec_version": "0.1",
  "description": "Two calls of a serial tool in one reply run one after the other in call order, and one tool line holds both results.",
  "agent": {
    "nickname": "Tater",
    "instructions": "Be brief.",
    "tools": [
      {
        "name": "echo",
        "description": "Echo the text back.",
        "input_schema": {
          "type": "object",
          "properties": {
            "text": {
              "type": "string"
            }
          },
          "required": [
            "text"
          ]
        },
        "concurrency": "serial",
        "behavior": {
          "type": "echo"
        }
      }
    ]
  },
  "providers": [
    {
      "name": "claude",
      "api": "anthropic.messages",
      "model": "claude-opus-5-5",
      "responses": [
        "responses/01.sse",
        "responses/02.sse"
      ]
    }
  ],
  "clock": {
    "start": "2026-09-26T00:00:00.000Z",
    "step_ms": 1
  },
  "ids": "sequential",
  "actions": [
    {
      "send": {
        "text": "Echo one, then two."
      }
    },
    {
      "wait": "idle"
    }
  ]
}
