      "keep": "after_cut"
    },
    "capabilities": [
      {
        "api": "anthropic.messages",
        "model_glob": "claude-opus-5-5",
        "caps": {
          "thinking_prefix_bound": true
        }
      }
    ]
  },
  "providers": [
    {
      "name": "claude",
