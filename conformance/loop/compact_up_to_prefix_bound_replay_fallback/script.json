        "text": "Second question."
      }
    },
    {
      "wait": "idle"
    },
    {
      "send": {
        "text": "Third question."
      }
    },
    {
      "wait": "idle"
    },
    {
      "compact": {
        "up_to": "turn_03"
      }
    },
    {
      "send": {
        "text": "Fourth question."
      }
    },
    {
      "wait": "idle"
    }
  ]
