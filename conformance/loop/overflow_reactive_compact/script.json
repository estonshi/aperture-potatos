{
  "spec_version": "0.1",
  "description": "The API rejects a request as too long. The session compacts once for that step (trigger overflow, a pre_compact block is ignored) and sends the step again on the compacted history.",
  "agent": {
    "nickname": "Tater",
    "instructions": "Be brief.",
    "tools": [],
    "compactor": {
      "instructions": "Summarize the conversation.",
      "keep": "current_turn"
    },
    "hooks": [
      {
        "point": "pre_compact",
        "name": "gate",
        "calls": [
          {
            "output": {
              "block": true,
              "reason": "not now"
            }
          }
        ]
      }
    ]
  },
  "providers": [
    {
      "name": "claude",
      "api": "anthropic.messages",
      "model": "claude-opus-5-5",
      "responses": [
        "responses/01.sse",
        {
          "sse": "responses/02.sse",
          "status": 400,
          "headers": {
            "Content-Type": "application/json"
          }
        },
        "responses/03.sse",
        "responses/04.sse"
      ]
    }
  ],
  "clock": {
    "start": "2026-09-26T00:00:00.000Z",
    "step_ms": 1
  },
  "ids": "sequential",
  "actions": [
    {
      "send": {
        "text": "Hi."
      }
    },
    {
      "wait": "idle"
    },
    {
      "send": {
        "text": "Now the long question."
      }
    },
    {
      "wait": "idle"
    }
  ]
}
