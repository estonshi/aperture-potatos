{
  "spec_version": "0.5",
  "description": "An interrupt ends a review that is still waiting: the call is not executed and the turn ends interrupted.",
  "agent": {
    "nickname": "Tater",
    "instructions": "Be brief.",
    "tools": [
      {
        "name": "sql_exec",
        "description": "Run one SQL statement.",
        "input_schema": {
          "type": "object",
          "properties": {
            "database": {
              "type": "string"
            },
            "statement": {
              "type": "string"
            },
            "read_only": {
              "type": "boolean"
            }
          },
          "required": [
            "database",
            "statement"
          ]
        },
        "concurrency": "serial",
        "behavior": {
          "type": "fixed",
          "text": "3 rows affected."
        }
      }
    ],
    "approval_rules": [
      {
        "id": "no-drop",
        "tool": "sql_exec",
        "when": {
          "statement": {
            "regex": "\\s*[dD][rR][oO][pP]\\b[\\s\\S]*"
          }
        },
        "action": "deny",
        "reason": "DROP statements are never allowed"
      },
      {
        "id": "prod-writes",
        "tool": "sql_exec",
        "when": {
          "database": {
            "eq": "prod"
          }
        },
        "action": "ask",
        "reason": "writes to the production database"
      },
      {
        "id": "prod-read-only",
        "tool": "sql_exec",
        "when": {
          "database": {
            "eq": "prod"
          },
          "read_only": {
            "eq": true
          }
        },
        "action": "allow"
      },
      {
        "id": "http-mutations",
        "tool": "http_*",
        "when": {
          "method": {
            "in": [
              "POST",
              "PUT",
              "DELETE"
            ]
          }
        },
        "action": "ask",
        "reason": "changes remote state"
      },
      {
        "id": "system-files",
        "tool": "write_file",
        "when": {
          "path": {
            "prefix": "/etc/",
            "normalize": "path"
          }
        },
        "action": "deny",
        "reason": "system configuration is read-only"
      }
    ],
    "hooks": [
      {
        "point": "approval",
        "name": "ui",
        "calls": [
          {
            "hold": true
          }
        ]
      }
    ]
  },
  "providers": [
    {
      "name": "claude",
      "api": "anthropic.messages",
      "model": "claude-opus-5-5",
      "responses": [
        "responses/01.sse"
      ]
    }
  ],
  "clock": {
    "start": "2026-09-26T00:00:00.000Z",
    "step_ms": 1
  },
  "ids": "sequential",
  "actions": [
    {
      "send": {
        "text": "Ship order 7."
      }
    },
    {
      "wait": {
        "event": "approval.requested"
      }
    },
    {
      "interrupt": {
        "reason": "user pressed stop"
      }
    },
    {
      "wait": "idle"
    }
  ]
}
