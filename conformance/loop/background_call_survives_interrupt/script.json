{
  "spec_version": "0.5",
  "description": "Moving the first of two serial calls lets the second start at once; an interrupt then stops the second call and ends the turn, but the moved call runs on as its task and its success is notified.",
  "agent": {
    "nickname": "Tater",
    "instructions": "Be brief.",
    "tools": [
      {
        "name": "run_build",
        "description": "Run the build.",
        "input_schema": {
          "type": "object",
          "properties": {
            "target": {
              "type": "string"
            }
          },
          "required": [
            "target"
          ]
        },
        "background": true,
        "behavior": {
          "type": "echo",
          "sleep_ms": 5000,
          "progress": [
            "compiling"
          ]
        }
      },
      {
        "name": "lint",
        "description": "Run the linter.",
        "input_schema": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            }
          },
          "required": [
            "path"
          ]
        },
        "behavior": {
          "type": "fixed",
          "text": "lint clean",
          "sleep_ms": 3000
        }
      }
    ]
  },
  "providers": [
    {
      "name": "claude",
      "api": "anthropic.messages",
      "model": "claude-opus-5-5",
      "responses": [
        "responses/01.sse",
        "responses/02.sse"
      ]
    }
  ],
  "clock": {
    "start": "2026-10-15T00:00:00.000Z",
    "step_ms": 1,
    "interleaved": true
  },
  "ids": "sequential",
  "actions": [
    {
      "send": {
        "text": "Build and lint."
      }
    },
    {
      "wait": {
        "event": "tool.started",
        "where": {
          "call_id": "toolu_01"
        }
      }
    },
    {
      "background_call": "toolu_01"
    },
    {
      "wait": {
        "event": "tool.started",
        "where": {
          "call_id": "toolu_02"
        }
      }
    },
    {
      "interrupt": {
        "reason": "user"
      }
    },
    {
      "wait": "idle"
    },
    {
      "wait_quiet": true
    }
  ]
}
