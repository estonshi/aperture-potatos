{
  "spec_version": "0.4",
  "description": "Arguments that name a key twice are invalid input before any hook, rule or tool sees them, because decoders disagree on which one wins.",
  "agent": {
    "nickname": "Tater",
    "instructions": "Be brief.",
    "tools": [
      {
        "name": "echo",
        "description": "Echo the text back.",
        "input_schema": {
          "type": "object",
          "properties": {
            "text": {
              "type": "string"
            }
          },
          "required": [
            "text"
          ]
        },
        "concurrency": "serial",
        "behavior": {
          "type": "echo"
        }
      }
    ],
    "approval_rules": [
      {
        "id": "no-drop",
        "tool": "sql_exec",
        "when": {
          "statement": {
            "regex": "\\s*[dD][rR][oO][pP]\\b[\\s\\S]*"
          }
        },
        "action": "deny",
        "reason": "DROP statements are never allowed"
      },
      {
        "id": "prod-writes",
        "tool": "sql_exec",
        "when": {
          "database": {
            "eq": "prod"
          }
        },
        "action": "ask",
        "reason": "writes to the production database"
      },
      {
        "id": "prod-read-only",
        "tool": "sql_exec",
        "when": {
          "database": {
            "eq": "prod"
          },
          "read_only": {
            "eq": true
          }
        },
        "action": "allow"
      },
      {
        "id": "http-mutations",
        "tool": "http_*",
        "when": {
          "method": {
            "in": [
              "POST",
              "PUT",
              "DELETE"
            ]
          }
        },
        "action": "ask",
        "reason": "changes remote state"
      },
      {
        "id": "system-files",
        "tool": "write_file",
        "when": {
          "path": {
            "prefix": "/etc/",
            "normalize": "path"
          }
        },
        "action": "deny",
        "reason": "system configuration is read-only"
      }
    ]
  },
  "providers": [
    {
      "name": "claude",
      "api": "anthropic.messages",
      "model": "claude-opus-5-5",
      "responses": [
        "responses/01.sse",
        "responses/02.sse"
      ]
    }
  ],
  "clock": {
    "start": "2026-09-26T00:00:00.000Z",
    "step_ms": 1
  },
  "ids": "sequential",
  "actions": [
    {
      "send": {
        "text": "Echo it."
      }
    },
    {
      "wait": "idle"
    }
  ]
}
