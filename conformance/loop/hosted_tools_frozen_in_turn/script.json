{
  "spec_version": "0.5",
  "clock": {
    "start": "2026-10-13T00:00:00.000Z",
    "step_ms": 1
  },
  "ids": "sequential",
  "description": "Hosted tools freeze with the turn: one added while a tool runs reaches only the next turn.",
  "agent": {
    "nickname": "Tater",
    "instructions": "Be brief.",
    "tools": [
      {
        "name": "slow_lookup",
        "description": "Look something up; it takes a while.",
        "input_schema": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string"
            }
          },
          "required": [
            "query"
          ]
        },
        "concurrency": "serial",
        "behavior": {
          "type": "fixed",
          "text": "Found three options.",
          "sleep_ms": 1000
        }
      }
    ]
  },
  "providers": [
    {
      "name": "claude",
      "api": "anthropic.messages",
      "model": "claude-opus-5-5",
      "responses": [
        "responses/01.sse",
        "responses/02.sse",
        "responses/03.sse"
      ]
    }
  ],
  "actions": [
    {
      "send": {
        "text": "Find a hotel in Kyoto."
      }
    },
    {
      "wait": {
        "event": "tool.started",
        "count": 1
      }
    },
    {
      "add_hosted_tool": {
        "name": "web_search",
        "web_search": {}
      }
    },
    {
      "wait": "idle"
    },
    {
      "send": {
        "text": "And the weather?"
      }
    },
    {
      "wait": "idle"
    }
  ]
}
