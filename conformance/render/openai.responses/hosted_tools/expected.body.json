{
  "include": [
    "web_search_call.action.sources",
    "reasoning.encrypted_content"
  ],
  "input": [
    {
      "content": [
        {
          "text": "What is the weather in Osaka?",
          "type": "input_text"
        }
      ],
      "role": "user",
      "type": "message"
    }
  ],
  "instructions": "<runtime-conventions>\n...\n</runtime-conventions>",
  "max_output_tokens": 64000,
  "model": "gpt-5.6",
  "reasoning": {
    "summary": "auto"
  },
  "store": false,
  "stream": true,
  "stream_options": {
    "include_obfuscation": false
  },
  "tools": [
    {
      "description": "Get the weather.",
      "name": "get_weather",
      "parameters": {
        "properties": {
          "city": {
            "type": "string"
          }
        },
        "required": [
          "city"
        ],
        "type": "object"
      },
      "strict": false,
      "type": "function"
    },
    {
      "filters": {
        "blocked_domains": [
          "example.net"
        ]
      },
      "search_context_size": "low",
      "type": "web_search",
      "user_location": {
        "city": "Osaka",
        "country": "JP",
        "type": "approximate"
      }
    },
    {
      "name": "web_fetch",
      "type": "web_fetch_preview"
    }
  ],
  "truncation": "disabled"
}
