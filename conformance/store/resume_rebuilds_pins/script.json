{
  "spec_version": "0.4",
  "description": "Resume rebuilds the pin set from the epoch head's pin reminders and the pins of later tool results, so a compaction after it re-injects both.",
  "agent": {
    "nickname": "Tater",
    "instructions": "Be brief.",
    "tools": [
      {
        "name": "load_b",
        "description": "Load load_b.",
        "input_schema": {
          "type": "object"
        },
        "concurrency": "serial",
        "behavior": {
          "type": "fixed",
          "text": "Loaded.",
          "pin": {
            "key": "b",
            "content": "Beta rules."
          }
        }
      }
    ],
    "compactor": {
      "summary": "B was loaded.",
      "keep": "none"
    }
  },
  "providers": [
    {
      "name": "claude",
      "api": "anthropic.messages",
      "model": "claude-opus-5-5",
      "responses": [
        "responses/01.sse"
      ]
    }
  ],
  "clock": {
    "start": "2026-09-29T00:00:00.000Z",
    "step_ms": 1
  },
  "ids": "sequential",
  "resume": {
    "session_id": "ses_s1",
    "file": "session.jsonl"
  },
  "actions": [
    {
      "compact": {}
    },
    {
      "send": {
        "text": "Next."
      }
    },
    {
      "wait": "idle"
    }
  ]
}
