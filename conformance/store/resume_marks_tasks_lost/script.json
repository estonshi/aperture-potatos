{
  "spec_version": "0.1",
  "description": "The file references a job that was still running and one that had finished. Resume rebuilds both from their last references: the running one is lost, reported by task.finished{lost} without a task.started, and its notice rides the next input instead of starting a turn. Its spec and state survived, so a restart runs it again.",
  "agent": {
    "nickname": "Tater",
    "instructions": "Be brief.",
    "tools": [],
    "task_kinds": [
      {
        "name": "job",
        "caps": {
          "restart": true
        },
        "start_tool": {
          "name": "start_job",
          "description": "Start a job.",
          "input_schema": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string"
              }
            },
            "required": [
              "title"
            ]
          }
        }
      }
    ]
  },
  "providers": [
    {
      "name": "claude",
      "api": "anthropic.messages",
      "model": "claude-opus-5-5",
      "responses": [
        "responses/01.sse",
        "responses/02.sse"
      ]
    }
  ],
  "clock": {
    "start": "2026-09-29T00:00:00.000Z",
    "step_ms": 1
  },
  "ids": "sequential",
  "resume": {
    "session_id": "ses_s1",
    "file": "session.jsonl"
  },
  "actions": [
    {
      "task": {
        "list": true
      }
    },
    {
      "send": {
        "text": "What happened to the crawl?"
      }
    },
    {
      "wait": "idle"
    },
    {
      "task": {
        "restart": "task_s1"
      }
    },
    {
      "task": {
        "step": "task_s1",
        "do": {
          "succeed": "Crawled 10 pages."
        }
      }
    },
    {
      "wait_quiet": true
    }
  ]
}
