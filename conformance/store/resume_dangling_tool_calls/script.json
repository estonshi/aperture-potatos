{
  "spec_version": "0.5",
  "description": "The file ends with a call the process never answered. Resume gives it a lost result before anything else, never runs it, and the session_start{resume} context rides the next turn as a reminder.",
  "agent": {
    "nickname": "Tater",
    "instructions": "Be brief.",
    "tools": [
      {
        "name": "echo",
        "description": "Echo the text back.",
        "input_schema": {
          "type": "object",
          "properties": {
            "text": {
              "type": "string"
            }
          },
          "required": [
            "text"
          ]
        },
        "concurrency": "serial",
        "behavior": {
          "type": "echo"
        }
      }
    ],
    "hooks": [
      {
        "point": "session_start",
        "name": "note",
        "calls": [
          {
            "output": {
              "additional_context": "Resumed after a restart."
            }
          }
        ]
      }
    ]
  },
  "providers": [
    {
      "name": "claude",
      "api": "anthropic.messages",
      "model": "claude-opus-5-5",
      "responses": [
        "responses/01.sse"
      ]
    }
  ],
  "clock": {
    "start": "2026-09-29T00:00:00.000Z",
    "step_ms": 1
  },
  "ids": "sequential",
  "resume": {
    "session_id": "ses_s1",
    "file": "session.jsonl"
  },
  "actions": [
    {
      "send": {
        "text": "Did it run?"
      }
    },
    {
      "wait": "idle"
    }
  ]
}
